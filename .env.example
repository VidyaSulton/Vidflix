# Salin file ini menjadi .env, lalu isi nilainya.
# Jangan pernah commit .env.

# ===== PostgreSQL (Docker Compose) =====
POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_DB=example
POSTGRES_PORT=5432

# Dipakai oleh backend/script/notebook yang berjalan di host.
# Host "localhost" karena port Postgres diekspos dari container ke mesin.
# Jika password mengandung karakter khusus, URL-encode nilainya.
DATABASE_URL=example

# ===== Auth =====
# Buat nilai acak, misalnya:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti_dengan_secret_acak_yang_panjang
JWT_EXPIRE_MINUTES=1440

# ===== TMDB =====
# API Key (v3 auth) dari https://www.themoviedb.org/settings/api
TMDB_API_KEY=ganti_dengan_api_key_tmdb
TMDB_LANGUAGE=en-US

# ===== Backend =====
CORS_ORIGINS=http://localhost:5173

# ===== Frontend (Vite) =====
VITE_API_BASE_URL=http://localhost:8000
